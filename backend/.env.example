# ---------------------------------------------------------------------------
# LLM provider. Both options include grounded web search, so no feature is
# lost either way. Set ONE key; the app picks it up automatically.
#
#   gemini  (default) - 5,000 free grounded prompts/month. Get a key at
#                       https://aistudio.google.com/apikey
#   claude            - Uses your Anthropic key and Claude's web_search tool.
#
# If the preferred provider's key is missing, the app falls back to the other
# one automatically rather than failing.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-sonnet-4-6

# Trial data comes from ClinicalTrials.gov's public API. It is free, needs no
# key, and has no credit limit.

# App settings
MOCK_SEARCH=false          # "true" skips all network calls and uses fixtures
MAX_TRIALS_RETURNED=5
CTGOV_PAGE_SIZE=25         # How many CT.gov trials to feed the ranker
RATE_LIMIT_PER_MINUTE=10

# Watchlist + email alerts
# DATABASE_URL: defaults to a local SQLite file (backend/trialfinder.db).
# For persistence in production, point at Postgres, e.g.
#   postgresql+psycopg://user:pass@host:5432/trialfinder
DATABASE_URL=

# ---------------------------------------------------------------------------
# Email delivery. Configure ONE of the options below. Needed for verification
# codes, password resets, and trial alerts.
#
# If neither is configured, the app does NOT pretend to have sent the email:
# it logs the message and returns the one-time code in the API response so
# local development still works. That never happens when ENVIRONMENT=production.
# ---------------------------------------------------------------------------

# Option 1 (recommended for development): SMTP via a free Gmail account.
# Sends to ANY recipient, unlike a sandboxed transactional provider.
# Requires 2-Step Verification and an App Password, NOT your normal password:
#   https://myaccount.google.com/apppasswords
#
# PRIVACY NOTE: Gmail rewrites the From header to whatever account you
# authenticate as, so EMAIL_FROM cannot hide it. If you do not want your
# personal address visible to every user, create a dedicated free Gmail
# (e.g. trialfinder.app@gmail.com) and authenticate as that instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourproject@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=TrialFinder <yourproject@gmail.com>

# Optional. Unlike From, Reply-To is never rewritten, so this is a reliable
# way to route replies to a different inbox than the sending account.
# EMAIL_REPLY_TO=TrialFinder Support <support@yourdomain.com>

# Option 2: Resend (https://resend.com). Better for production.
# IMPORTANT: a new Resend account is sandboxed. With the shared
# onboarding@resend.dev sender it will ONLY deliver to the address you
# signed up with, and returns HTTP 403 for anyone else. To send to real
# users, verify a domain at https://resend.com/domains and set EMAIL_FROM
# to an address on that domain.
# RESEND_API_KEY=
# EMAIL_FROM=TrialFinder <noreply@yourdomain.com>

# Resend takes priority if both are set.

# REQUIRED to enable POST /api/watchlist/check. That endpoint sweeps every
# account and can send email, so without this token it is disabled entirely
# (fails closed) rather than left open to the internet.
CRON_TOKEN=

# --- Environment ------------------------------------------------------------
# "production" enables the HTTPS redirect and HSTS, hides /docs and /openapi,
# stops one-time codes being echoed in API responses, and turns a missing or
# weak JWT_SECRET into a hard startup failure instead of a warning.
ENVIRONMENT=development

# --- Authentication ---------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12               # short-lived access tokens

# Brute-force and replay protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
VERIFICATION_TTL_MINUTES=30
RESET_TTL_MINUTES=30

# --- Deployment hardening ---------------------------------------------------
# Exact browser origin(s) allowed to call this API, comma-separated.
# In production the wildcard *.vercel.app rule is disabled, so set this.
FRONTEND_URL=

# Host header allowlist, e.g. trialfinder-api.up.railway.app
ALLOWED_HOSTS=

# Read the client IP from X-Forwarded-For. Correct behind Railway/Render/
# Vercel. Set false only if the app is directly exposed with no proxy.
TRUST_PROXY_HEADERS=true
